<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: launchd/install.sh fills in __REPO__, __UV__ and __UV_DIR__. Do not load as is. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tommy.investment-assist.weekly</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>__REPO__/launchd/job.sh</string>
        <string>weekly</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__REPO__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>ASSIST_UV</key>
        <string>__UV__</string>
        <key>PATH</key>
        <string>__UV_DIR__:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__REPO__/launchd/weekly.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO__/launchd/weekly.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
