{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tomtomtomdev/investment-assist/schema/frameworks.schema.json",
  "title": "investment-assist baseline board (screens and frameworks side by side)",
  "description": "PLAN S94 (phase Q rules 3-4): each IDN screen's and registered framework's replay picks (top quintile at each quarter end) through the S92 picks report, against the JCI price index and the same-date eligible pool equal-weighted, per window 1m-5y, with the independent windows behind each mean, the gate state and the delisted coverage. Written to out/frameworks/{MARKET}.json by `assist frameworks`. Heuristic context, not investment advice.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "market", "built", "as_of", "windows", "verdict_note", "method", "ranking",
    "frameworks", "skipped", "stale_inputs", "sources", "disclaimer"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\.\\d+\\.\\d+$"},
    "market": {"type": "string"},
    "built": {"$ref": "#/$defs/date", "description": "Run date of `assist frameworks`."},
    "as_of": {"$ref": "#/$defs/nullable_date", "description": "Windows ending after this are open: the earlier of the last JCI bar and the newest bar of any held name."},
    "windows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["window", "months", "verdict_window"],
        "properties": {
          "window": {"type": "string"},
          "months": {"type": "integer", "minimum": 1},
          "verdict_window": {"type": "boolean", "description": "True for 1m-6m, the only windows that may carry a verdict."}
        }
      }
    },
    "verdict_note": {"type": "string"},
    "method": {"type": "string"},
    "ranking": {
      "type": "object",
      "description": "Per window, the entries with a figure, best excess total return vs the pool first.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "excess_pool", "excess_jci", "n_independent"],
          "properties": {
            "name": {"type": "string"},
            "excess_pool": {"type": "number"},
            "excess_jci": {"$ref": "#/$defs/num"},
            "n_independent": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "frameworks": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "reason"],
        "properties": {"name": {"type": "string"}, "reason": {"type": "string"}}
      }
    },
    "stale_inputs": {"type": "array", "items": {"type": "string"}},
    "sources": {"type": "array", "items": {"type": "string"}},
    "disclaimer": {"type": "string"}
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "nullable_date": {"anyOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
    "num": {"type": ["number", "null"]},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "kind", "description", "basis", "cadence", "status", "gate", "starts",
        "first_start", "last_start", "mean_picks", "mean_pool", "survivorship", "windows", "notes"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["screen", "framework"]},
        "description": {"type": "string"},
        "basis": {"type": "string", "description": "How the held names are chosen."},
        "cadence": {"type": ["string", "null"]},
        "status": {"enum": ["ok", "no picks", "no replay"]},
        "gate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "reason"],
          "properties": {
            "state": {"enum": ["untested", "failed", "passed"]},
            "reason": {"type": ["string", "null"]}
          }
        },
        "starts": {"type": "integer", "minimum": 0},
        "first_start": {"$ref": "#/$defs/nullable_date"},
        "last_start": {"$ref": "#/$defs/nullable_date"},
        "mean_picks": {"$ref": "#/$defs/num"},
        "mean_pool": {"$ref": "#/$defs/num"},
        "survivorship": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["delisted_known", "delisted_in_pool", "delisted_picked", "pool_names",
                           "picked_names", "stopped", "note"],
              "properties": {
                "delisted_known": {"type": "integer", "minimum": 0},
                "delisted_in_pool": {"type": "integer", "minimum": 0},
                "delisted_picked": {"type": "integer", "minimum": 0},
                "pool_names": {"type": "integer", "minimum": 0},
                "picked_names": {"type": "integer", "minimum": 0},
                "stopped": {"type": "array", "items": {"type": "string"}},
                "note": {"type": "string"}
              }
            }
          ]
        },
        "windows": {"type": "array", "items": {"$ref": "#/$defs/window"}},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window", "months", "verdict_window", "n_starts", "n_independent", "total",
                   "price", "dividend", "jci", "pool_total", "excess_jci", "excess_pool",
                   "rank_pool"],
      "properties": {
        "window": {"type": "string"},
        "months": {"type": "integer", "minimum": 1},
        "verdict_window": {"type": "boolean"},
        "n_starts": {"type": "integer", "minimum": 0},
        "n_independent": {"type": "integer", "minimum": 0},
        "total": {"$ref": "#/$defs/num", "description": "Mean equal-weighted total return (price + dividend, not reinvested), fraction."},
        "price": {"$ref": "#/$defs/num"},
        "dividend": {"$ref": "#/$defs/num"},
        "jci": {"$ref": "#/$defs/num", "description": "Mean JCI price return over the same starts."},
        "pool_total": {"$ref": "#/$defs/num"},
        "excess_jci": {"$ref": "#/$defs/num"},
        "excess_pool": {"$ref": "#/$defs/num"},
        "rank_pool": {"type": ["integer", "null"], "minimum": 1}
      }
    }
  }
}
