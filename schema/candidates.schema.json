{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tomtomtomdev/investment-assist/schema/candidates.schema.json",
  "title": "investment-assist undervalued candidates (one market)",
  "description": "PLAN S20: one ranked list of undervalued stocks per market, in IDR, written to out/candidates/{MARKET}.json. Each style (dividend_value, garp; S15's value later) is ranked by its own margin over the hurdle, never by a score mixed across styles. A style whose placebo verdict failed is listed with its verdict and no names. Extends the stance contract's model_fingerprint, stale_inputs, sources and disclaimer semantics. Heuristic context, not investment advice.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "market", "as_of", "bar_date", "currency", "model_fingerprint", "regime",
    "hurdle", "stance", "tilt", "styles", "sizing", "config", "stale_inputs", "sources",
    "disclaimer"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "market": {"type": "string", "pattern": "^[A-Z0-9_]+$", "description": "ISO3 market code."},
    "as_of": {"$ref": "#/$defs/date", "description": "Run date."},
    "bar_date": {"anyOf": [{"$ref": "#/$defs/date"}, {"type": "null"}], "description": "Last price bar the screens used."},
    "currency": {"const": "IDR", "description": "Every return and amount is in IDR, unhedged."},
    "model_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "regime": {"enum": ["risk_on", "neutral", "risk_off", null]},
    "hurdle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_pt", "drivers"],
      "properties": {
        "required_pt": {"type": ["number", "null"], "description": "The market's IDR hurdle (S17), % a year; null when unknown."},
        "drivers": {"$ref": "#/$defs/texts"}
      }
    },
    "stance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stance", "current_pct", "target_pct"],
      "properties": {
        "stance": {"enum": ["overweight", "neutral", "underweight", "avoid", null]},
        "current_pct": {"type": ["number", "null"]},
        "target_pct": {"type": ["number", "null"]}
      }
    },
    "tilt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "verdict", "fingerprint", "sectors"],
      "properties": {
        "passed": {"type": "boolean", "description": "Only a passed verdict shifts margins and sets sector caps."},
        "verdict": {"type": "string"},
        "fingerprint": {"type": ["string", "null"], "description": "sha256 of config/sector_tilt.yaml."},
        "sectors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sector", "tilt", "margin_shift_pt", "cap"],
            "properties": {
              "sector": {"type": "string"},
              "tilt": {"type": "number", "minimum": -1, "maximum": 1},
              "margin_shift_pt": {"type": "number", "description": "Applied shift of the required margin (0 unless the verdict passed)."},
              "cap": {"type": "integer", "minimum": 0, "description": "Applied names-per-sector cap."}
            }
          }
        }
      }
    },
    "styles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["style", "passed", "verdict", "pool", "rows", "dropped"],
        "properties": {
          "style": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"},
          "verdict": {"type": "string", "description": "The placebo verdict's reason."},
          "t": {"type": ["number", "null"]},
          "p": {"type": ["number", "null"]},
          "quarters": {"type": ["integer", "null"]},
          "pool": {"type": "integer", "minimum": 0, "description": "Names that passed every gate today."},
          "rows": {"type": "array", "items": {"$ref": "#/$defs/row"}, "description": "Empty when the verdict failed."},
          "dropped": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["symbol", "reason"],
              "properties": {"symbol": {"type": "string"}, "reason": {"type": "string"}}
            }
          }
        },
        "if": {"properties": {"passed": {"const": false}}},
        "then": {"properties": {"rows": {"maxItems": 0}}}
      }
    },
    "sizing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["portfolio_value_idr", "budget_idr", "unspent_idr", "trims", "excluded", "fingerprint"],
      "properties": {
        "portfolio_value_idr": {"type": ["number", "null"]},
        "budget_idr": {"type": "number", "minimum": 0},
        "unspent_idr": {"type": "number"},
        "trims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["symbol", "idr", "reason"],
            "properties": {"symbol": {"type": "string"}, "idr": {"type": "number"}, "reason": {"type": "string"}}
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["symbol", "reason"],
            "properties": {"symbol": {"type": "string"}, "reason": {"type": "string"}}
          }
        },
        "fingerprint": {"type": "string"}
      }
    },
    "diversification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "size_lines", "names"],
      "description": "PLAN S82 (schema 1.3.0): one verdict per held or kept name. A redundant name that is not allowed gets no new money and is first in line when the leg is cut; it is never trimmed for that alone.",
      "properties": {
        "level": {"type": "string", "description": "The idx-method industry_membership column used as the industry."},
        "size_lines": {"type": "object", "description": "Market cap in IDR at or above which a name is large / mid."},
        "names": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["symbol", "sector", "industry", "mktcap", "size", "group_size", "position", "keeper", "redundant", "allowed", "basis"],
            "properties": {
              "symbol": {"type": "string"},
              "sector": {"type": ["string", "null"]},
              "industry": {"type": ["string", "null"]},
              "mktcap": {"type": ["number", "null"]},
              "size": {"enum": ["large", "mid", "small", null]},
              "div_yield": {"type": ["number", "null"], "description": "The screener's dividend yield (schema 1.3.1): the order among names no passing screen rated."},
              "group_size": {"type": "integer", "minimum": 1},
              "position": {"type": "integer", "minimum": 1, "description": "Order within the group; 1 is the keeper."},
              "keeper": {"type": "string"},
              "redundant": {"type": "boolean"},
              "allowed": {"type": "boolean", "description": "Redundant, but a passed tilt favours its sector or industry."},
              "basis": {"enum": ["kept by a passing screen", "ranked by a passing screen", "unrated"]}
            }
          }
        }
      }
    },
    "average_down": {
      "type": "object",
      "additionalProperties": false,
      "required": ["underwater_pct", "gate3", "names"],
      "description": "PLAN S68 (schema 1.1.0): one verdict per held name of this market, a row or not. Cost basis decides no size.",
      "properties": {
        "underwater_pct": {"type": "number", "description": "% below the average cost that counts as underwater."},
        "gate3": {"enum": ["context", "binding"], "description": "Whether the entry status may stop an average down: binding only after its placebo passes."},
        "names": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["symbol", "status", "gate", "reason", "avg_cost", "quantity", "price", "below_cost_pct", "new_avg_cost", "entry_status"],
            "properties": {
              "symbol": {"type": "string"},
              "status": {"enum": ["average_down", "unfunded", "stopped"]},
              "gate": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
              "reason": {"type": "string"},
              "avg_cost": {"type": ["number", "null"]},
              "quantity": {"type": ["number", "null"]},
              "price": {"type": ["number", "null"]},
              "below_cost_pct": {"type": ["number", "null"]},
              "new_avg_cost": {"type": ["number", "null"]},
              "entry_status": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "config": {"type": "object", "description": "What the model fingerprint does not show by name: the tilt yaml hash, hurdle constants, sizing caps and each screen's CONFIG."},
    "stale_inputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "data_problems": {
      "type": "array", "items": {"type": "string", "minLength": 1},
      "description": "P103 (1.4.0): inputs found broken this run (a key screener column null for every name, or a passing screen with an empty pool). Any entry holds the guide's steps. Absent before 1.4.0."
    },
    "watchlist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["as_of", "stale", "category", "missing", "screeners", "members", "in_pool", "rows"],
      "description": "S89 (1.6.0): the user's Stockbit screeners read as a watchlist only (phase P rule 1). A name on one that no passing screen ranked is judged by the holding record's code (thesis, valuation, fit) as a `source: watchlist` row; membership never changes a size, a rank, a trim or a verdict. IDN only; absent when no watchlist was read and before 1.6.0.",
      "properties": {
        "as_of": {"$ref": "#/$defs/date", "description": "The screener_member date read (newest on or before the run)."},
        "stale": {"type": ["string", "null"], "description": "Why the member date is too old; a stale input, never a failure."},
        "category": {"type": ["string", "null"], "description": "The Stockbit category read when no screener is configured."},
        "missing": {"type": "array", "items": {"type": "string"}, "description": "Configured screeners not found on that date."},
        "screeners": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "category", "totalrows", "fetched", "members"],
            "properties": {
              "id": {"type": "integer"},
              "name": {"type": "string"},
              "category": {"type": ["string", "null"]},
              "totalrows": {"type": ["integer", "null"]},
              "fetched": {"type": ["integer", "null"]},
              "members": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "members": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}, "description": "symbol → the screeners it is on."},
        "in_pool": {"type": "array", "items": {"type": "string"}, "description": "Watchlist names a passing screen ranked: judged in their style, no watchlist row."},
        "rows": {"type": "array", "items": {"$ref": "#/$defs/watchlist_row"}}
      }
    },
    "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "disclaimer": {"type": "string", "pattern": "[Nn]ot investment advice"}
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "watchlist_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "source", "screeners", "sector", "held", "held_idr", "action", "size", "thesis", "valuation", "fit", "inputs"],
      "properties": {
        "symbol": {"type": "string", "minLength": 1},
        "source": {"const": "watchlist"},
        "screeners": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "sector": {"type": ["string", "null"]},
        "held": {"type": "boolean"},
        "held_idr": {"type": "number", "minimum": 0},
        "action": {"const": "watch", "description": "Membership is never an add, a trim or a sell."},
        "size": {"type": "null"},
        "thesis": {"type": "object", "required": ["status", "gate", "severity"], "properties": {"status": {"enum": ["pass", "fail", "unknown"]}}},
        "valuation": {"type": "object", "required": ["price", "fair_price", "above_fair"]},
        "fit": {"type": "object", "required": ["group", "redundant", "keeper", "ok"]},
        "inputs": {"type": "object"}
      }
    },
    "texts": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "average_down_verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "gate", "reason"],
      "properties": {
        "status": {"enum": ["average_down", "unfunded", "stopped"], "description": "average_down: cleared every gate and sized; unfunded: cleared gates 1, 2 and 4 but the market has no budget, sized 0; stopped: at `gate`."},
        "gate": {"type": ["integer", "null"], "minimum": 1, "maximum": 5, "description": "The gate it stopped at (1 underwater, 2 thesis, 4 room, 5 money); null when it cleared all. Gate 3 (entry status) is context."},
        "reason": {"type": "string"}
      }
    },
    "framework_result": {
      "type": "object",
      "additionalProperties": false,
      "description": "PLAN S93: one framework's result for one name (frameworks document §0.2 plus role and gate). score null means not computable, and flags say why (never imputed).",
      "required": ["framework", "ticker", "as_of", "score", "signal", "components", "flags", "version", "role", "gate"],
      "properties": {
        "framework": {"type": "string", "minLength": 1},
        "ticker": {"type": "string", "minLength": 1},
        "as_of": {"anyOf": [{"$ref": "#/$defs/date"}, {"type": "null"}], "description": "The date the signal could first be known (the fundamentals' available date)."},
        "score": {"type": ["number", "null"]},
        "signal": {"type": "string", "minLength": 1},
        "components": {"type": "object", "additionalProperties": {"type": ["number", "null"]}},
        "flags": {"type": "array", "items": {"type": "string"}},
        "version": {"type": "string", "minLength": 1},
        "role": {"enum": ["context", "exclusion", "quality", "valuation"]},
        "gate": {"enum": ["untested", "failed", "passed"]}
      },
      "if": {"properties": {"score": {"type": "null"}}},
      "then": {"properties": {"flags": {"minItems": 1}}}
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank", "symbol", "style", "sector", "expected_pt", "margin_pt", "margin_shift_pt",
        "net_margin_pt", "drivers", "risks", "price", "entry", "cost", "held", "held_idr",
        "action", "size"
      ],
      "properties": {
        "rank": {"type": "integer", "minimum": 1, "description": "Rank within the style, by margin."},
        "symbol": {"type": "string", "minLength": 1},
        "style": {"type": "string"},
        "sector": {"type": ["string", "null"]},
        "expected_pt": {"type": "number", "description": "Expected IDR return, % a year."},
        "margin_pt": {"type": "number", "description": "Expected − (hurdle + the sector's applied tilt shift), pt."},
        "margin_shift_pt": {"type": "number"},
        "net_margin_pt": {"type": "number", "description": "margin_pt less one modelled round trip a year."},
        "drivers": {"$ref": "#/$defs/texts"},
        "risks": {"$ref": "#/$defs/texts"},
        "price": {"type": ["number", "null"]},
        "entry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "basis", "status"],
          "properties": {
            "level": {"type": ["number", "null"]},
            "basis": {"enum": ["typical", "deep", "none"]},
            "status": {"type": "string"}
          }
        },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "required": ["order_idr", "round_trip_bps", "flags"],
          "properties": {
            "order_idr": {"type": "number"},
            "round_trip_bps": {"type": "number"},
            "flags": {"type": "array", "items": {"type": "string"}}
          }
        },
        "held": {"type": "boolean"},
        "held_idr": {"type": "number", "minimum": 0},
        "action": {"enum": ["add", "average_down", "hold", "watch"], "description": "add: sized; average_down: a sized add on a held name 5% or more below its average cost (PLAN S68); hold: held, nothing to add; watch: passes, not sized (see sizing.excluded)."},
        "cost_basis": {
          "description": "Layer 5's cost basis of a held name (schema 1.1.0). A label, never a signal.",
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["avg_cost", "quantity", "below_cost_pct", "new_avg_cost"],
              "properties": {
                "avg_cost": {"type": "number", "description": "Quantity-weighted average cost per share across accounts (financer)."},
                "quantity": {"type": "number"},
                "below_cost_pct": {"type": ["number", "null"], "description": "Price against the average cost, %; negative = below cost."},
                "new_avg_cost": {"type": ["number", "null"], "description": "Average cost after the sized tranches, all filled at today's price, buy fee included; null when nothing is sized."}
              }
            }
          ]
        },
        "exits": {
          "type": "object",
          "additionalProperties": false,
          "description": "Execution guidance (schema 1.2.0, PLAN S74): changes no size and no name.",
          "required": ["entry_cap", "take_profit", "take_profit_basis", "take_profit_action", "thesis_stop", "review_at", "review_note"],
          "properties": {
            "entry_cap": {"type": ["number", "null"], "description": "The first tranche buys at market, not above this price (last close + 1%)."},
            "take_profit": {"type": ["number", "null"], "description": "The fair price: where the margin over the required return reaches 0; null when the style has no closed form."},
            "take_profit_basis": {"enum": ["fair_price", "none"]},
            "take_profit_action": {"type": "string", "description": "What reaching the take-profit means."},
            "thesis_stop": {"type": "string", "description": "The stop that sells: the name fails its screen."},
            "review_at": {"type": ["number", "null"], "description": "The name's own deep-drawdown level, when below the price: a flag, never a sale."},
            "review_note": {"type": "string"}
          }
        },
        "frameworks": {
          "type": "array",
          "items": {"$ref": "#/$defs/framework_result"},
          "description": "P110 (schema 1.5.0): the registered frameworks' results for this name. Context results change no size, rank or verdict; an adopted exclusion (role exclusion, gate passed; S103, 1.7.0) is listed here and its block is `buy_blocked`. Absent when no framework is registered."
        },
        "buy_blocked": {
          "type": "string",
          "minLength": 1,
          "description": "P123 (S103, schema 1.7.0): why an adopted exclusion framework blocks new money for this name (e.g. the Magic Formula's bottom fifth). Blocks buys only: the row is never trimmed or sold for it. Absent when nothing blocks."
        },
        "average_down": {
          "description": "The average-down verdict of a held name (schema 1.1.0); null when not held.",
          "anyOf": [{"type": "null"}, {"$ref": "#/$defs/average_down_verdict"}]
        },
        "size": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["idr", "tranches", "reason"],
              "properties": {
                "idr": {"type": "number", "minimum": 0},
                "reason": {"type": "string"},
                "tranches": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["day", "idr", "shares", "limit"],
                    "properties": {
                      "day": {"type": "integer", "minimum": 0},
                      "idr": {"type": "number"},
                      "shares": {"type": "integer", "minimum": 0},
                      "limit": {"type": ["number", "null"]}
                    }
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
