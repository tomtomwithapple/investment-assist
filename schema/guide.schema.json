{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tomtomtomdev/investment-assist/schema/guide.schema.json",
  "title": "investment-assist guide (this week's steps)",
  "description": "PLAN S75: one run's stances, candidates and layer 5 as an ordered list of orders with amount, shares, dated tranches, entry price, take-profit, stop and strength, written to out/guide.json. Heuristic context, not investment advice.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "as_of", "model_fingerprint", "regime", "headline", "headline_note", "split",
    "portfolio_value_idr", "legs", "steps", "totals", "config", "notes", "disclaimer"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "as_of": {"$ref": "#/$defs/date", "description": "Run date."},
    "model_fingerprint": {"type": ["string", "null"]},
    "regime": {"enum": ["risk_on", "neutral", "risk_off", null]},
    "headline": {"type": "string", "description": "The regime in plain words."},
    "headline_note": {"type": "string"},
    "split": {"type": "integer", "minimum": 1, "description": "The most tranches any step has."},
    "portfolio_value_idr": {"type": ["number", "null"]},
    "legs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["market", "asset", "label", "stance", "benchmark_pct", "current_pct", "target_pct", "gap_idr"],
        "properties": {
          "market": {"type": "string"},
          "asset": {"type": "string"},
          "label": {"type": "string"},
          "stance": {"type": ["string", "null"]},
          "benchmark_pct": {"type": "number"},
          "current_pct": {"type": ["number", "null"]},
          "target_pct": {"type": ["number", "null"]},
          "gap_idr": {"type": ["number", "null"], "description": "Target minus held, IDR; negative = sell."}
        }
      }
    },
    "steps": {"type": "array", "items": {"$ref": "#/$defs/step"}},
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sell_idr", "buy_idr", "sells", "buys"],
      "properties": {
        "sell_idr": {"type": "number"},
        "buy_idr": {"type": "number"},
        "sells": {"type": "integer"},
        "buys": {"type": "integer"}
      }
    },
    "config": {"type": "object"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "held_for_data": {
      "type": "array", "items": {"type": "string", "minLength": 1},
      "description": "P103 (1.1.0): '<MARKET>: <problem>' per broken input; non-empty means steps is empty on purpose. Absent before 1.1.0."
    },
    "disclaimer": {"type": "string"}
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "n", "side", "kind", "market", "asset", "symbol", "label", "idr", "shares", "tranches",
        "take_profit", "stop", "strength", "why", "detail", "tags"
      ],
      "properties": {
        "n": {"type": "integer", "minimum": 1},
        "side": {"enum": ["sell", "buy"]},
        "kind": {"enum": ["name", "bucket"], "description": "name: one stock; bucket: an amount for a leg, the reader picks the product."},
        "market": {"type": "string"},
        "asset": {"type": "string"},
        "symbol": {"type": ["string", "null"]},
        "label": {"type": "string"},
        "idr": {"type": "number", "minimum": 0},
        "shares": {"type": ["integer", "null"]},
        "tranches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["date", "idr", "shares", "price"],
            "properties": {
              "date": {"$ref": "#/$defs/date"},
              "idr": {"type": "number", "minimum": 0},
              "shares": {"type": ["integer", "null"]},
              "price": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "at"],
                "properties": {
                  "type": {"enum": ["market", "market_cap", "limit"], "description": "market: at market; market_cap: at market, not above `at`; limit: at `at` or lower."},
                  "at": {"type": ["number", "null"]}
                }
              }
            }
          }
        },
        "take_profit": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["at", "action", "basis"],
              "properties": {
                "at": {"type": "number"},
                "action": {"type": ["string", "null"]},
                "basis": {"type": "string"}
              }
            }
          ]
        },
        "stop": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["rule", "review_at", "note"],
              "properties": {
                "rule": {"type": "string", "description": "The stop that sells."},
                "review_at": {"type": ["number", "null"], "description": "A price that flags the name and sells nothing."},
                "note": {"type": "string"}
              }
            }
          ]
        },
        "strength": {"enum": ["strong", "medium", "weak"]},
        "why": {"type": "string"},
        "detail": {"type": "string", "description": "The page that shows the evidence."},
        "tags": {"type": "array", "items": {"type": "string"}},
        "question": {"enum": ["thesis", "valuation", "fit", null], "description": "S86 (1.2.0): which of the three questions drove a sell, from the holding record; null for buys and when no record says. Absent before 1.2.0."}
      }
    }
  }
}
